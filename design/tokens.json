  "dimension_notes": {
    "units": "Points at text size 13, set in code as rems(value / 13) so they grow with the text size. Radii, strokes and the focus ring are pixels and stay as they are.",
    "radius": "xs: keycap, tag. sm: tile, inner segment. md: field, button, selection, sidebar, banner. lg: card, panel, HUD, popover (the GPUI Kit popover rounds with the theme radius, 8). xl: dialog, onboarding card. pill: the 44 high capsule. Nested: inner radius is the outer radius minus the gap.",
    "padding": "Detail 24, field card 12 and 16, dialog 24, onboarding 32"
  },
  "typography": {
    "size.standard": 13,
    "size.large": 15,
    "families": {
      "ui": ".SystemUIFont",
      "mono": "Atkinson Hyperlegible Mono"
    },
    "styles": {
      "display": { "size": 26, "line": 32, "weight": 600 },
      "title1": { "size": 22, "line": 28, "weight": 600 },
      "search": { "size": 20, "line": 26, "weight": 400, "usage": "Search field of the quick panel" },
      "title2": { "size": 17, "line": 22, "weight": 600 },
      "title3": { "size": 15, "line": 20, "weight": 600 },
      "headline": { "size": 13, "line": 16, "weight": 600, "usage": "Buttons, section headers, the selected row" },
      "row-title": { "size": 13, "line": 16, "weight": 530, "usage": "Row title when not selected" },
      "body": { "size": 13, "line": 18, "weight": 400 },
      "callout": { "size": 12, "line": 16, "weight": 400, "usage": "Second line, field caption" },
      "caption": { "size": 11, "line": 14, "weight": 530, "usage": "Labels, counters, keycaps" },
      "secret": { "size": 15, "line": 20, "weight": 400, "family": "mono", "usage": "Groups of four" },
      "generator": { "size": 20, "line": 26, "weight": 400, "family": "mono" },
      "code": { "size": 22, "line": 28, "weight": 500, "family": "mono", "features": ["tnum"] },
      "typing": { "size": 48, "line": 56, "weight": 400, "family": "mono", "usage": "Large type for typing a secret by hand" }
    },
    "notes": "Medium of the system font is weight 530: 500 lands on Regular. For Atkinson, 500 is Medium. Every number that changes uses tnum. Nothing below 11, no capitals."
  },
  "contrast": {
    "sets": {
      "surfaces": ["bg.window", "bg.surface", "bg.sidebar", "bg.elevated", "bg.hover", "bg.selected", "bg.selected.unfocused"],
      "soft": ["status.ok.soft", "status.attention.soft", "status.decision.soft", "status.danger.soft"]
    },
    "pairs": [
      { "fg": "text.primary", "on": "surfaces", "min": [4.5, 7], "documented": { "light": 13.92, "dark": 11.77 } },
      { "fg": "text.secondary", "on": "surfaces", "min": [4.5, 7], "documented": { "light": 5.72, "dark": 5.66 } },
      { "fg": "text.tertiary", "on": "surfaces", "min": [4.5, 7], "documented": { "light": 4.83, "dark": 4.59 } },
      { "fg": "accent.text", "also": ["secret.symbol"], "on": "surfaces", "min": [4.5, 7], "documented": { "light": 4.97, "dark": 6.15 } },
      { "fg": "status.ok.text", "on": "surfaces", "min": [4.5, 7], "documented": { "light": 4.87, "dark": 7.43 } },
      { "fg": "status.attention.text", "on": "surfaces", "min": [4.5, 7], "documented": { "light": 4.66, "dark": 7.30 } },
      { "fg": "status.decision.text", "also": ["secret.digit"], "on": "surfaces", "min": [4.5, 7], "documented": { "light": 4.76, "dark": 5.88 } },
      { "fg": "status.danger.text", "on": "surfaces", "min": [4.5, 7], "documented": { "light": 5.19, "dark": 5.32 } },
      { "fg": "border.control", "on": "surfaces", "min": [3, 4.5], "documented": { "light": 3.27, "dark": 3.19 } },
      { "fg": "focus.ring", "also": ["clipboard.thread"], "on": "surfaces", "min": [3, 4.5], "documented": { "light": 3.54, "dark": 4.91 } },
      { "fg": "team.teal", "on": "surfaces", "min": [3, 4.5] },
      { "fg": "team.plum", "on": "surfaces", "min": [3, 4.5] },
      { "fg": "team.moss", "on": "surfaces", "min": [3, 4.5] },
      { "fg": "team.slate", "on": "surfaces", "min": [3, 4.5] },
      { "fg": "accent.on", "on": ["accent.fill"], "min": [4.5, 7], "documented": { "light": 5.29, "dark": 6.59 } },
      { "fg": "accent.on", "on": ["accent.fill.hover"], "min": [4.5, 7], "documented": { "light": 6.76, "dark": 7.80 } },
      { "fg": "status.danger.on", "on": ["status.danger.fill"], "min": [4.5, 7], "documented": { "light": 6.45, "dark": 6.97 } },
      { "fg": "status.ok.text", "on": ["status.ok.soft"], "min": [4.5, 7], "documented": { "light": 5.19, "dark": 7.45 } },
      { "fg": "status.attention.text", "also": ["prd.chip.text"], "on": ["status.attention.soft"], "min": [4.5, 7], "documented": { "light": 4.98, "dark": 7.01 } },
      { "fg": "status.decision.text", "on": ["status.decision.soft"], "min": [4.5, 7], "documented": { "light": 4.96, "dark": 6.28 } },
      { "fg": "status.danger.text", "on": ["status.danger.soft"], "min": [4.5, 7], "documented": { "light": 5.33, "dark": 5.84 } },
      { "fg": "text.primary", "on": "soft", "min": [4.5, 7] },
      { "fg": "text.secondary", "on": ["bg.keycap"], "min": [4.5, 7] },
      { "fg": "border.separator", "on": "surfaces", "min": [null, 3] },
      { "fg": "border.keycap", "on": ["bg.keycap", "bg.surface", "bg.window"], "min": [null, 3] },
      { "fg": "bg.selected", "on": ["bg.surface"], "min": [3, 4.5] }
    ],
    "notes": "min is [normal, increased contrast]; null means decorative, with no minimum. A pair holds when the lowest ratio over its surfaces reaches the minimum, without rounding. A pair or mode that does not hold, or has no minimum, needs an entry in exempt. documented holds the ratios the design spec states for light and dark, rounded to two places."
  },
  "exempt": [
    { "fg": "bg.selected", "on": ["bg.surface"], "modes": ["light", "dark", "light-hc", "dark-hc"], "reason": "The selection is only about 1.2:1 against the surface. A selected row also gets semibold text, a focus ring when the keyboard is in use, and the selected state for VoiceOver; with increased contrast it also gets an inner border in border.control." },
    { "fg": "border.separator", "on": "surfaces", "modes": ["light", "dark"], "reason": "Decorative. Nothing depends on seeing a separator; with increased contrast it reaches 3:1." },
    { "fg": "border.keycap", "on": ["bg.keycap", "bg.surface", "bg.window"], "modes": ["light", "dark"], "reason": "Decorative. The keycap text carries the meaning; with increased contrast the border reaches 3:1." }
  ],
  "neutral_family": {
    "tokens": ["bg.window", "bg.surface", "bg.sidebar", "bg.elevated", "bg.hover", "bg.selected.unfocused", "bg.keycap", "border.separator", "border.keycap"],
    "hue": [55, 90],
    "dark_max_chroma": 0.008,
    "notes": "One warm neutral family. Text and control neutrals (chroma up to 0.020) are left out, or they would lose contrast."
  },
  "hue_separation": {
    "reserved": ["accent.fill", "status.attention.text", "status.danger.text", "status.decision.text"],
    "team": ["team.teal", "team.plum", "team.moss", "team.slate"],
    "min_distance": 45,
    "min_chroma": 0.06,
    "low_chroma": ["team.slate"],
    "notes": "Copper, ochre, carmine and blue each carry one meaning, so a vault colour keeps its distance from them. A team colour below min_chroma reads as grey and is exempt, but only when it is listed in low_chroma."
  },
